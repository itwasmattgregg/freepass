# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite database file (optional; defaults to ./data/freepass.db)
# DATABASE_PATH=/absolute/path/to/freepass.db

# Optional: magic-link + trial notification email via Resend.
# Without RESEND_API_KEY, magic links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=FreePass <onboarding@resend.dev>
